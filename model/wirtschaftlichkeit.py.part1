    "Versicherung, Audit, laufende Rechtsberatung": 45_000,
    "Werkzeuge, Dev-Accounts, Reporting": 18_000,
}
SALES = {
    "Vertrieb (2 FTE)": 160_000,
    "Marketing, Messen, Content-Marketing": 120_000,
}

# Markt
SAM_DACH = 19_000     # freie Mehrmarken-Werkstaetten DACH, zahlungsfaehig und diagnose-relevant
CHURN_Y = 0.12        # Logo-Churn p.a.
AMORT_YEARS = 5       # Amortisationsdauer der Entwicklungskosten

# Vertriebsszenarien: Neukunden je Monat nach Launch
# "sales" = Vertriebs-/Marketingbudget p.a. (Szenario-spezifisch),
# "chains" = einmalige Kundenbuendel aus Ketten-/Partner-Deals (Monat, Anzahl)
SCENARIOS = {
    "S1 Direktvertrieb": {"ramp": 1, "start": 3, "cap": 8, "channel_from": 10**6, "channel_pm": 0,
                          "chains": [], "sales": 280_000},
    "S2 Direkt + Fachhandel": {"ramp": 1, "start": 3, "cap": 8, "channel_from": 13, "channel_pm": 14,
                               "chains": [], "sales": 280_000},
    "S3 + Ketten-/Partner-Deals": {"ramp": 1, "start": 3, "cap": 8, "channel_from": 13, "channel_pm": 14,
                                   "chains": [(18, 250), (30, 250), (42, 250)], "sales": 300_000},
    "S4 Lean + Fachhandel": {"ramp": 1, "start": 3, "cap": 5, "channel_from": 10, "channel_pm": 14,
                             "chains": [(16, 200), (28, 200), (40, 200)], "sales": 156_000},
}

# ----------------------------------------------------------------------------
# 2. Rechenkern
# ----------------------------------------------------------------------------

def dev_cost(v: dict) -> dict:
    years = v["months"] / 12
    pers = {k: f * RATES[k] * years for k, f in v["fte"].items()}
    pers_sum = sum(pers.values())
    sach = v["sach_pm"] * v["months"]
    mkt = v["marketing"]
    sub = pers_sum + sach + mkt
    puf = sub * v["puffer"]
    return {
        "personal": pers,
        "personal_sum": pers_sum,
        "sach": sach,
        "marketing": mkt,
        "puffer": puf,
        "total": sub + puf,
        "fte_total": sum(v["fte"].values()),
    }


def content_cost(s: dict) -> dict:
    return {"items": s["items"], "total": sum(s["items"].values())}


def pricing(arpa: float) -> dict:
    var = sum(VAR_COST.values())
    revenue = arpa * 12
    db = revenue - var
    return {
        "arpa": arpa,
        "revenue": revenue,
        "var": var,
        "db": db,
        "margin": db / revenue,
        "ltv": db / CHURN_Y,
    }


def breakeven(dev_total: float, content_total: float, price: dict) -> dict:
    fix = content_total + sum(OVERHEAD.values()) + sum(SALES.values())
    amort = dev_total / AMORT_YEARS
    fix_amort = fix + amort
    cust = fix_amort / price["db"]
    return {
        "fix": fix,
        "amort": amort,
        "fix_amort": fix_amort,
        "customers": cust,
        "revenue": cust * price["revenue"],
        "sam_share": cust / SAM_DACH,
        "customers_8y": (fix + dev_total / 8) / price["db"],
    }


def new_customers(month_after_launch: int, sc: dict) -> float:
    t = month_after_launch
    n = min(sc["cap"], sc["start"] + sc["ramp"] * (t - 1))
    if t >= sc["channel_from"]:
        n += sc["channel_pm"]
    for (tm, add) in sc.get("chains", []):
        if t == tm:
            n += add
    return n


def cashflow(dev_total: float, v: dict, content_total: float, arpa: float, sc: dict,
             horizon: int = 72) -> dict:
    """Monatlicher Cashflow. Entwicklungskosten linear ueber die Entwicklungsmonate."""
    churn_m = 1 - (1 - CHURN_Y) ** (1 / 12)
    var_m = sum(VAR_COST.values()) / 12
    fix_m = (content_total + sum(OVERHEAD.values()) + sc.get("sales", sum(SALES.values()))) / 12
    dev_m = dev_total / v["months"] if v["months"] else 0

    arpa_ramp = {1: arpa * 0.92, 2: arpa, 3: arpa * 1.03, 4: arpa * 1.05, 5: arpa * 1.07, 6: arpa * 1.07}

    customers = 0.0
    cum = 0.0
    rows = []
    min_cum, min_month = 0.0, 0
    be_month = None
    for m in range(1, horizon + 1):
        spend_dev = dev_m if m <= v["months"] else 0.0
        t = m - v["launch"] + 1
        rev = 0.0
        if t >= 1:
            customers = customers * (1 - churn_m) + new_customers(t, sc)
            year_idx = min(6, max(1, (t - 1) // 12 + 1))
            rev = customers * arpa_ramp[year_idx]
        opex = fix_m + customers * var_m
        net = rev - opex - spend_dev
        cum += net
        if cum < min_cum:
            min_cum, min_month = cum, m
        if be_month is None and t >= 1 and net > 0:
            be_month = m
        rows.append({
            "monat": m, "kunden": customers, "umsatz": rev, "opex": opex,
            "entwicklung": spend_dev, "netto": net, "kumuliert": cum,
        })
    final = rows[-1]
    return {
        "rows": rows,
        "be_month": be_month,
        "max_drawdown": min_cum,
        "max_drawdown_month": min_month,
        "cum_72": final["kumuliert"],
        "customers_72": final["kunden"],
        "revenue_72_y": sum(r["umsatz"] for r in rows[-12:]),
    }


# ----------------------------------------------------------------------------
# 3. Berechnung
# ----------------------------------------------------------------------------

DEV = {k: dev_cost(v) for k, v in VARIANTS.items()}
CON = {k: content_cost(s) for k, s in STAGES.items()}
PRICE = {k: pricing(s["arpa"]) for k, s in STAGES.items()}
BE = {(vk, sk): breakeven(DEV[vk]["total"], CON[sk]["total"], PRICE[sk])
      for vk in VARIANTS for sk in STAGES}

COMBOS = [("V1", "A"), ("V2", "A"), ("V2", "B"), ("V3", "B"), ("V3", "C"), ("V3", "D")]
CF = {}
for vk, sk in COMBOS:
    for sc_name, sc in SCENARIOS.items():
        CF[(vk, sk, sc_name)] = cashflow(DEV[vk]["total"], VARIANTS[vk], CON[sk]["total"],
                                         STAGES[sk]["arpa"], sc)

# ----------------------------------------------------------------------------
# 4. Excel
# ----------------------------------------------------------------------------

EUR = '#,##0 "€"'
EUR2 = '#,##0.00 "€"'
PCT = '0.0 %'
NUM = '#,##0'

H1 = Font(bold=True, size=14, color="FFFFFF")
H2 = Font(bold=True, size=11, color="FFFFFF")
BOLD = Font(bold=True)
SMALL = Font(italic=True, size=9, color="666666")
FILL_T = PatternFill("solid", fgColor="1F3864")
FILL_H = PatternFill("solid", fgColor="2E5C8A")
FILL_S = PatternFill("solid", fgColor="DCE6F1")
FILL_R = PatternFill("solid", fgColor="F2F2F2")
THIN = Side(style="thin", color="BFBFBF")
BOX = Border(top=THIN, bottom=THIN, left=THIN, right=THIN)


def title(ws, row: int, text: str, span: int = 8):
    c = ws.cell(row=row, column=1, value=text)
    c.font = H1
    c.fill = FILL_T
    c.alignment = Alignment(vertical="center")
    ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=span)
    ws.row_dimensions[row].height = 24
    return row + 1


def head(ws, row: int, labels, widths=None):
    for i, t in enumerate(labels, start=1):
        c = ws.cell(row=row, column=i, value=t)
        c.font = H2
        c.fill = FILL_H
        c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        c.border = BOX
    ws.row_dimensions[row].height = 30
    if widths:
        for i, w in enumerate(widths, start=1):
            ws.column_dimensions[get_column_letter(i)].width = w
    return row + 1


def line(ws, row: int, values, fmt=None, bold=False, shade=False):
    for i, v in enumerate(values, start=1):
        c = ws.cell(row=row, column=i, value=v)
        c.border = BOX
        if bold:
            c.font = BOLD
        if shade:
            c.fill = FILL_R
        if fmt and isinstance(v, (int, float)) and i > 1:
            c.number_format = fmt
            c.alignment = Alignment(horizontal="right")
    return row + 1


def note(ws, row: int, text: str, span: int = 8):
    c = ws.cell(row=row, column=1, value=text)
    c.font = SMALL
    c.alignment = Alignment(wrap_text=True, vertical="top")
    ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=span)
    return row + 1


wb = Workbook()

