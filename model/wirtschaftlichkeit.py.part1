         [34, 18, 18, 18, 16, 18, 14, 20, 18])

for vk, sk in COMBOS:
    b = BE[(vk, sk)]
    c1 = CF[(vk, sk, "S3 + Ketten-/Partner-Deals")]
    r = line(ws, r, [f"{VARIANTS[vk]['label']} / {STAGES[sk]['label']} ({STAGES[sk]['scope']})",
                     DEV[vk]["total"], CON[sk]["total"], b["fix"], round(b["customers"]),
                     round(b["revenue"]), b["sam_share"], c1["max_drawdown"],
                     c1["be_month"] if c1["be_month"] else "> 72"],
