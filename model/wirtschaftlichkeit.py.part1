# Variable Kosten je Kunde und Jahr
VAR_COST = {
    "Cloud/Infrastruktur/Datenvolumen": 42,
    "Zahlung, Rechnung, Mahnwesen": 28,
    "Support (1 FTE je 900 Kunden)": 87,
    "Onboarding/Schulung (auf 3 Jahre verteilt)": 55,
}

# Fixkostenbloecke im Betrieb (unabhaengig von der Abdeckung)
OVERHEAD = {
    "Verwaltung, Finance, HR (1,5 FTE)": 135_000,
    "Produktmanagement (1 FTE)": 115_000,
    "Security/Compliance (0,4 FTE)": 50_000,
