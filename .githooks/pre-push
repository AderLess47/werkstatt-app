#!/bin/sh
# Pre-Push: keine Übertragung ohne grüne Tests — aber auch keine Tests, die
# nichts prüfen können.
#
# Zwei Läufe stehen zur Verfügung, beide aus dem Repository, nicht aus der CI:
#
#   scripts/kern-tests.sh   C-Kern (159 Prüfungen), Korpus, Rust-Kern, FFI
#   scripts/jvm-tests.sh    die 119 JVM-Tests der App
#
# Welche davon laufen, entscheiden die Dateien, die tatsächlich gepusht werden:
# eine Doku-Korrektur startet keine Cargo- oder JVM-Tests, eine Änderung an
# `j2534/` keine JVM-Tests. Unbekannte Pfade lassen beide laufen — im Zweifel
# wird geprüft, nicht geraten.
#
# Warum lokal und nicht nur in der CI: die Actions-Läufe dieses Repos starten
# nicht — jedes Job-Ergebnis ist „The job was not started because recent account
# payments have failed or your spending limit needs to be increased“, also kein
# Runner, kein Schritt, kein Test.
#
# Einbauen:      sh scripts/install-hooks.sh
# Abschalten:    VCI_SKIP_HOOK=1 git push …   (oder git push --no-verify)
# Der Hook sagt beim Überspringen, dass er übersprungen wurde — still wäre es
# dasselbe wie „grün“.

set -eu

cd "$(git rev-parse --show-toplevel)"

zuruecksetzen() { rm -f "$dateien"; }
dateien=$(mktemp)
trap 'zuruecksetzen' EXIT INT TERM

# Git schreibt je Ref „<lokale ref> <sha> <remote ref> <sha>“ nach stdin. Diese
# Zeilen sind die einzige verlässliche Auskunft darüber, was übertragen wird.
refs=$(cat)

if [ "${VCI_SKIP_HOOK:-0}" = "1" ]; then
    echo "pre-push: Tests übersprungen (VCI_SKIP_HOOK=1) — geprüft wurde nichts." >&2
    exit 0
fi

# Die Dateimenge aller gepushten Refs. Vier Fälle:
#   - Ref wird gelöscht (lokale Sha null): nichts zu prüfen
#   - neuer Branch (remote Sha null): ohne Vergleichsbasis wird alles geprüft
#   - bekannt: Diff zwischen remote und lokal
#   - Diff nicht möglich (force push, unbekannte Sha): alles prüfen
while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] || continue
    case "$lsha" in 0000000000*) continue ;; esac
    case "${rsha:-}" in
        0000000000*|"")
            echo '*' >> "$dateien"
            continue
            ;;
    esac
    git diff --name-only "$rsha" "$lsha" >> "$dateien" 2>/dev/null ||
        echo '*' >> "$dateien"
done <<EOF
$refs
EOF

# Kein stdin (Aufruf von Hand) heißt: nichts bekannt, also alles prüfen.
[ -s "$dateien" ] || echo '*' >> "$dateien"

kern=0
jvm=0
doku=0
while read -r f; do
    case "$f" in
        '') continue ;;
        '*')
            kern=1
            jvm=1
            ;;
        docs/* | *.md | artifacts/* | model/*) doku=1 ;;
        core/* | core-ffi/* | j2534/*) kern=1 ;;
        android/*) jvm=1 ;;
        scripts/kern-tests.sh) kern=1 ;;
        scripts/jvm-tests.sh) jvm=1 ;;
        *) kern=1; jvm=1 ;;
    esac
done < "$dateien"

if [ "$kern" -eq 0 ] && [ "$jvm" -eq 0 ]; then
    echo "pre-push: nur Doku geändert ($(sort -u "$dateien" | wc -l | tr -d ' ') Dateien) — keine Tests nötig." >&2
    exit 0
fi

fehlgeschlagen=0
gesamt_start=$(date +%s)

# Beide Läufe werden gefahren, auch wenn der erste rot ist: wer ohnehin nicht
# pushen kann, soll alle Befunde auf einmal sehen. Die Ausgabe kommt gesammelt,
# weil ein Fehlschlag mitten in einer Fortschrittszeile sonst unlesbar ist.
pruefe() { # <Titel> <Skript>
    titel=$1
    skript=$2
    log=$(mktemp)
    start=$(date +%s)

    echo "pre-push: $titel läuft …" >&2
    if sh "$skript" > "$log" 2>&1; then
        echo "pre-push: $titel grün ($(( $(date +%s) - start )) s)." >&2
        rm -f "$log"
        return 0
    fi

    fehlgeschlagen=1
    echo "pre-push: $titel rot ($(( $(date +%s) - start )) s):" >&2
    echo "------------------------------------------------------------" >&2
    tail -n 40 "$log" | sed 's/^/    /' >&2
    echo "------------------------------------------------------------" >&2
    rm -f "$log"
    return 0
}

# Bewusst kein `[ … ] && pruefe …`: unter `set -e` beendet die fehlgeschlagene
# Bedingung das Skript, statt die Prüfung zu überspringen.
if [ "$kern" -eq 1 ]; then
    pruefe "Rust- und C-Kern" scripts/kern-tests.sh
fi
if [ "$jvm" -eq 1 ]; then
    pruefe "JVM-Tests der App" scripts/jvm-tests.sh
fi

if [ "$fehlgeschlagen" -ne 0 ]; then
    echo "pre-push: Tests rot — Push abgebrochen, nichts wurde übertragen." >&2
    echo "Ganze Ausgabe: sh scripts/kern-tests.sh  bzw.  sh scripts/jvm-tests.sh" >&2
    exit 1
fi

echo "pre-push: alles grün in $(( $(date +%s) - gesamt_start )) s." >&2
