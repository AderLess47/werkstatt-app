#!/bin/sh
# Pre-Push: keine Übertragung ohne grüne Tests — aber auch keine Tests, die
# nichts prüfen können.
#
# Drei Läufe stehen zur Verfügung, alle aus dem Repository, nicht aus der CI:
#
#   scripts/kern-tests.sh   C-Kern, Korpus, Rust-Kern, FFI
#   scripts/jvm-tests.sh    die JVM-Tests der App
#   scripts/fuzz.sh         Rauchlauf der Fuzz-Ziele (ISO-TP, UDS)
#
# Welche davon laufen, entscheiden die Dateien, die tatsächlich gepusht werden:
# eine Doku-Korrektur startet keine Cargo- oder JVM-Tests, eine Änderung an
# `j2534/` keine JVM-Tests. Unbekannte Pfade lassen alle laufen — im Zweifel
# wird geprüft, nicht geraten.
#
# Der Fuzz-Rauchlauf hängt enger: er läuft nur bei `core/src/isotp.rs`,
# `core/src/uds.rs` und `core/fuzz/`. Er braucht nightly und cargo-fuzz, die
# nicht zur normalen Werkzeugkette gehören (rund ein halber Gigabyte) — fehlen
# sie, sagt der Hook das und lässt den Rauchlauf aus, statt einen Push an einem
# optionalen Werkzeug scheitern zu lassen. Ausgelassen heißt hier nicht grün:
# die Zeile steht da.
#
# Die Formatprüfung fährt kein Skript, sondern `rustfmt --check` — und zwar nur
# für die Rust-Dateien, die dieser Push anfasst, nicht für das ganze Crate. Das
# Crate ist überwiegend von Hand formatiert; ein Lauf über alles würde jeden
# Push blockieren, bis der Reformat übertragen ist (docs/ci.md). So gilt die
# Regel, die durchsetzbar ist: wer eine Datei ändert, liefert sie formatiert ab.
#
# Fehlt `rustfmt` — oder nur seine rustup-Komponente —, sagt der Hook das und
# lässt den Schritt aus. Ein Werkzeugausfall ist kein Formatbefund.
#
# Trockenlauf, ohne zu pushen und ohne zu testen:
#
#   sh .githooks/pre-push --probe              (gegen den Upstream-Branch)
#   sh .githooks/pre-push --probe origin/main  (gegen eine bestimmte Basis)
#
# Er zeigt dieselbe Auswahl, die ein Push jetzt treffen würde — dieselbe
# Einstufung, kein zweiter Code, der auseinanderlaufen kann. Unterschieden wird
# nur die Herkunft der Dateiliste: beim Push aus Gits stdin, im Trockenlauf aus
# dem Diff gegen die Basis.
#
# Einbauen:      sh scripts/install-hooks.sh
# Abschalten:    VCI_SKIP_HOOK=1 git push …   (oder git push --no-verify)
# Der Hook sagt beim Überspringen, dass er übersprungen wurde — still wäre es
# dasselbe wie „grün“.

set -eu

cd "$(git rev-parse --show-toplevel)"

modus=push
basis=""
if [ "${1:-}" = "--probe" ]; then
    modus=probe
    shift || true
    basis=${1:-}
fi

zuruecksetzen() { rm -f "$dateien" "$rustdateien"; }
dateien=$(mktemp)
rustdateien=$(mktemp)
trap 'zuruecksetzen' EXIT INT TERM

if [ "$modus" = "push" ]; then
    # Git schreibt je Ref „<lokale ref> <sha> <remote ref> <sha>“ nach stdin.
    # Diese Zeilen sind die einzige verlässliche Auskunft darüber, was
    # übertragen wird.
    refs=$(cat)

    if [ "${VCI_SKIP_HOOK:-0}" = "1" ]; then
        echo "pre-push: Tests übersprungen (VCI_SKIP_HOOK=1) — geprüft wurde nichts." >&2
        exit 0
    fi

    # Vier Fälle je Ref:
    #   - Ref wird gelöscht (lokale Sha null): nichts zu prüfen
    #   - neuer Branch (remote Sha null): ohne Vergleichsbasis wird alles geprüft
    #   - bekannt: Diff zwischen remote und lokal
    #   - Diff nicht möglich (force push, unbekannte Sha): alles prüfen
    while read -r _lref lsha _rref rsha; do
        [ -n "${lsha:-}" ] || continue
        case "$lsha" in 0000000000*) continue ;; esac
        case "${rsha:-}" in
            0000000000*|"")
                echo '*' >> "$dateien"
                continue
                ;;
        esac
        git diff --name-only "$rsha" "$lsha" >> "$dateien" 2>/dev/null ||
            echo '*' >> "$dateien"
    done <<EOF
$refs
EOF

    # Kein stdin (Aufruf von Hand) heißt: nichts bekannt, also alles prüfen.
    # Ein *leerer* Diff ist dagegen eine gültige Auskunft — „nichts zu
    # übertragen“ (etwa wenn der Remote-Stand schon erreicht ist) — und darf
    # nicht als Unbekanntes gewertet werden.
    if [ -z "$refs" ]; then
        echo '*' >> "$dateien"
    fi
else
    # Trockenlauf: Basis ist der Upstream des aktuellen Branches, sonst der
    # übliche Remote-Branch, sonst gibt es nichts zu vergleichen.
    if [ -z "$basis" ]; then
        basis=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
    fi
    if [ -z "$basis" ]; then
        for kandidat in origin/main origin/master origin/HEAD; do
            if git rev-parse --verify --quiet "$kandidat" > /dev/null 2>&1; then
                basis=$kandidat
                break
            fi
        done
    fi

    if [ -n "$basis" ] && git rev-parse --verify --quiet "$basis" > /dev/null 2>&1; then
        voraus=$(git rev-list --count "$basis"..HEAD 2>/dev/null || echo '?')
        echo "Trockenlauf gegen $basis ($voraus Commit(s) voraus)" >&2
        git diff --name-only "$basis"...HEAD > "$dateien"
    else
        basis=""
        echo '*' >> "$dateien"
        echo "Trockenlauf ohne Vergleichsbasis — es würden alle Prüfungen laufen." >&2
    fi
fi

kern=0
jvm=0
fuzz=0
doku=0
while read -r f; do
    case "$f" in
        '') continue ;;
        '*')
            kern=1
            jvm=1
            fuzz=1
            ;;
        docs/* | *.md | artifacts/* | model/*) doku=1 ;;
        core/src/isotp.rs | core/src/uds.rs) kern=1; fuzz=1 ;;
        core/fuzz/*) fuzz=1 ;;
        core/* | core-ffi/* | j2534/*) kern=1 ;;
        android/*) jvm=1 ;;
        scripts/kern-tests.sh) kern=1 ;;
        scripts/jvm-tests.sh) jvm=1 ;;
        *) kern=1; jvm=1 ;;
    esac
done < "$dateien"

anzahl=$(sort -u "$dateien" | wc -l | tr -d ' ')

# Welche Rust-Dateien dieser Push anfasst — Grundlage der Formatprüfung. Der
# Stern steht für „Dateiliste unbekannt“ (neuer Branch, Force-Push); dann lässt
# sich keine Datei benennen, und die Prüfung sagt das, statt zu raten.
rustliste_unbekannt=0
: > "$rustdateien"
while read -r f; do
    case "$f" in
        '') continue ;;
        '*') rustliste_unbekannt=1 ;;
        *.rs) [ -f "$f" ] && echo "$f" >> "$rustdateien" ;;
    esac
done < "$dateien"

if [ "$modus" = "probe" ]; then
    if [ -n "$basis" ]; then
        echo "Geänderte Dateien:" >&2
        sort -u "$dateien" | sed 's/^/  /' >&2
    fi
    if [ "$kern" -eq 0 ] && [ "$jvm" -eq 0 ] && [ "$fuzz" -eq 0 ] && [ ! -s "$rustdateien" ]; then
        if [ "$anzahl" -eq 0 ]; then
            echo "Auswahl: nichts — keine Änderungen gegenüber $basis." >&2
        else
            echo "Auswahl: nichts — nur Doku, ein Push würde keine Tests starten." >&2
        fi
        exit 0
    fi
    echo "Auswahl:" >&2
    if [ "$kern" -eq 1 ]; then
        echo "  scripts/kern-tests.sh  (C-Kern, Korpus, Rust-Kern, FFI-Schicht)" >&2
    fi
    if [ "$jvm" -eq 1 ]; then
        echo "  scripts/jvm-tests.sh   (die JVM-Tests der App)" >&2
    fi
    if [ "$fuzz" -eq 1 ]; then
        echo "  scripts/fuzz.sh        (Rauchlauf ISO-TP und UDS, ${VCI_FUZZ_SEKUNDEN:-20} s je Ziel)" >&2
    fi
    if [ -s "$rustdateien" ]; then
        echo "  rustfmt --check        (nur die geänderten Rust-Dateien: $(sort -u "$rustdateien" | wc -l | tr -d ' '))" >&2
    elif [ "$rustliste_unbekannt" -eq 1 ]; then
        echo "  rustfmt --check        (würde ausgelassen — Dateiliste unbekannt)" >&2
    fi
    exit 0
fi

if [ "$kern" -eq 0 ] && [ "$jvm" -eq 0 ] && [ "$fuzz" -eq 0 ] && [ ! -s "$rustdateien" ]; then
    if [ "$anzahl" -eq 0 ]; then
        echo "pre-push: nichts zu übertragen — keine Tests nötig." >&2
    else
        echo "pre-push: nur Doku geändert ($anzahl Dateien) — keine Tests nötig." >&2
    fi
    exit 0
fi

fehlgeschlagen=0
gesamt_start=$(date +%s)

# Format zuerst: sie dauert Millisekunden, und wer ohnehin formatieren muss, soll
# das vor den Tests erfahren. Fehlende `rustfmt` lassen den Schritt sichtbar aus
# — wie beim Fuzz-Werkzeug, statt einen Push an einem Komponenten-Fehler zu
# beenden.
#
# Geprüft wird mit einem echten Aufruf, nicht mit `command -v`: rustup legt seine
# Proxy-Binaries in ~/.cargo/bin unabhängig von den installierten Komponenten ab.
# Fehlt die Komponente, findet `command -v` den Proxy trotzdem, und `rustfmt
# --check` endet für jede Datei mit einem Fehler — die Schleife unten würde dann
# eine formatierte Datei als „nicht formatiert“ melden und die falsche Reparatur
# empfehlen. `rustfmt --version` unterscheidet die beiden Fälle.
rustfmt_bereit() {
    command -v rustfmt > /dev/null || return 1
    rustfmt --version > /dev/null 2>&1
}

format_pruefen() {
    if ! rustfmt_bereit; then
        echo "pre-push: Formatprüfung übersprungen — rustfmt fehlt (rustup component add rustfmt)." >&2
        return 0
    fi

    unformatiert=""
    while read -r f; do
        rustfmt --check --edition 2021 "$f" > /dev/null 2>&1 || unformatiert="$unformatiert $f"
    done < "$rustdateien"

    if [ -n "$unformatiert" ]; then
        fehlgeschlagen=1
        echo "pre-push: Format rot — diese Dateien sind nicht rustfmt-sauber:" >&2
        for f in $unformatiert; do
            echo "    $f" >&2
        done
        echo "pre-push: beheben mit  rustfmt --edition 2021 <datei>" >&2
    else
        echo "pre-push: Format grün ($(sort -u "$rustdateien" | wc -l | tr -d ' ') Rust-Datei(en) geprüft)." >&2
    fi

    if [ "$rustliste_unbekannt" -eq 1 ]; then
        echo "pre-push: Vergleichsbasis unbekannt — geprüft wurden nur die benannten Dateien." >&2
    fi
}

# Alle Läufe werden gefahren, auch wenn der erste rot ist: wer ohnehin nicht
# pushen kann, soll alle Befunde auf einmal sehen. Die Ausgabe kommt gesammelt,
# weil ein Fehlschlag mitten in einer Fortschrittszeile sonst unlesbar ist.
pruefe() { # <Titel> <Skript>
    titel=$1
    skript=$2
    log=$(mktemp)
    start=$(date +%s)

    echo "pre-push: $titel läuft …" >&2
    if sh "$skript" > "$log" 2>&1; then
        echo "pre-push: $titel grün ($(( $(date +%s) - start )) s)." >&2
        rm -f "$log"
        return 0
    fi

    fehlgeschlagen=1
    echo "pre-push: $titel rot ($(( $(date +%s) - start )) s):" >&2
    echo "------------------------------------------------------------" >&2
    tail -n 40 "$log" | sed 's/^/    /' >&2
    echo "------------------------------------------------------------" >&2
    rm -f "$log"
    return 0
}

# Fehlt das Fuzz-Werkzeug, wird der Schritt ausgelassen und benannt. Ohne diese
# Prüfung würde `scripts/fuzz.sh` mit Exit 1 enden und den Push blockieren — für
# ein Werkzeug, das nicht jeder Arbeitsplatz hat.
fuzz_bereit() {
    command -v cargo-fuzz > /dev/null || {
        echo "pre-push: Fuzz-Rauchlauf übersprungen — cargo-fuzz fehlt (cargo install cargo-fuzz --locked)." >&2
        return 1
    }
    rustc +nightly --version > /dev/null 2>&1 || {
        echo "pre-push: Fuzz-Rauchlauf übersprungen — nightly fehlt (rustup toolchain install nightly)." >&2
        return 1
    }
    return 0
}

if [ -s "$rustdateien" ]; then
    format_pruefen
elif [ "$rustliste_unbekannt" -eq 1 ]; then
    echo "pre-push: Formatprüfung übersprungen — geänderte Dateien unbekannt (neuer Branch oder Force-Push)." >&2
fi

# Bewusst kein `[ … ] && pruefe …`: unter `set -e` beendet die fehlgeschlagene
# Bedingung das Skript, statt die Prüfung zu überspringen.
if [ "$kern" -eq 1 ]; then
    pruefe "Rust- und C-Kern" scripts/kern-tests.sh
fi
if [ "$jvm" -eq 1 ]; then
    pruefe "JVM-Tests der App" scripts/jvm-tests.sh
fi

# Kurz, weil er bei jedem Push auf Parser-Code mitläuft: 20 s je Ziel zeigen,
# dass die Ziele noch bauen und nicht sofort abstürzen. Die zehn Minuten aus der
# Definition of Done bleiben Handarbeit (`sh scripts/fuzz.sh`).
if [ "$fuzz" -eq 1 ] && fuzz_bereit; then
    VCI_FUZZ_SEKUNDEN=${VCI_FUZZ_SEKUNDEN:-20}
    export VCI_FUZZ_SEKUNDEN
    pruefe "Fuzz-Rauchlauf (${VCI_FUZZ_SEKUNDEN} s je Ziel)" scripts/fuzz.sh
fi

if [ "$fehlgeschlagen" -ne 0 ]; then
    echo "pre-push: Prüfung rot — Push abgebrochen, nichts wurde übertragen." >&2
    echo "Ganze Ausgabe: sh scripts/kern-tests.sh, sh scripts/jvm-tests.sh bzw. sh scripts/fuzz.sh" >&2
    exit 1
fi

echo "pre-push: alles grün in $(( $(date +%s) - gesamt_start )) s." >&2
