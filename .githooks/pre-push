#!/bin/sh
# Pre-Push: keine Übertragung ohne grüne Tests — aber auch keine Tests, die
# nichts prüfen können.
#
# Zwei Läufe stehen zur Verfügung, beide aus dem Repository, nicht aus der CI:
#
#   scripts/ci-lokal.sh     die Jobs aus .github/workflows/ci.yml
#                           (`c`, `rust`, `clippy`, `fmt`, `jvm-tests`)
#   scripts/fuzz.sh         Rauchlauf der Fuzz-Ziele (ISO-TP, UDS)
#
# Warum der CI-Lauf und nicht mehr die einzelnen Skripte: der Workflow startet in
# diesem Repository nicht (kein Runner, siehe docs/ci.md). Wenn der Hook etwas
# anderes prüft als der Workflow, prüft er am Ende etwas anderes, als in der
# Ankündigung steht — also ruft er dieselben Jobs mit denselben Befehlen auf,
# nur eben hier. `scripts/kern-tests.sh` und `scripts/jvm-tests.sh` bleiben als
# einzelne Einstiegspunkte für die Hand bestehen; der Hook braucht sie nicht
# mehr, weil `c` und `rust` bzw. `jvm-tests` dasselbe abdecken.
#
# Welche Jobs laufen, entscheiden die Dateien, die tatsächlich gepusht werden:
# eine Änderung an `j2534/` startet keine JVM-Tests, eine an `android/` keine
# Cargo-Prüfungen. Reine Doku (`docs/`, `*.md`, `artifacts/`, `model/`) lässt
# alle fünf laufen — siehe unten bei der Einordnung. Unbekannte Pfade ebenfalls:
# im Zweifel wird geprüft, nicht geraten.
#
# Der Fuzz-Rauchlauf hängt enger: er läuft nur bei `core/src/isotp.rs`,
# `core/src/uds.rs` und `core/fuzz/`. Er braucht nightly und cargo-fuzz, die
# nicht zur normalen Werkzeugkette gehören (rund ein halber Gigabyte) — fehlen
# sie, sagt der Hook das und lässt den Rauchlauf aus, statt einen Push an einem
# optionalen Werkzeug scheitern zu lassen. Ausgelassen heißt hier nicht grün:
# die Zeile steht da.
#
# Dasselbe gilt für `cargo fmt`: fehlt die rustfmt-Komponente, wird der
# `fmt`-Job ausgelassen und benannt. Ein Werkzeugausfall ist kein Formatbefund —
# und eine Prüfung, die jede Datei als unformatiert meldet, wäre schlimmer als
# keine.
#
# Trockenlauf, ohne zu pushen und ohne zu testen:
#
#   sh .githooks/pre-push --probe              (gegen den Upstream-Branch)
#   sh .githooks/pre-push --probe origin/main  (gegen eine bestimmte Basis)
#
# Er zeigt dieselbe Auswahl, die ein Push jetzt treffen würde — dieselbe
# Einstufung, kein zweiter Code, der auseinanderlaufen kann. Unterschieden wird
# nur die Herkunft der Dateiliste: beim Push aus Gits stdin, im Trockenlauf aus
# dem Diff gegen die Basis.
#
# Einbauen:      sh scripts/install-hooks.sh
# Abschalten:    VCI_SKIP_HOOK=1 git push …   (oder git push --no-verify)
# Der Hook sagt beim Überspringen, dass er übersprungen wurde — still wäre es
# dasselbe wie „grün“.

set -eu

cd "$(git rev-parse --show-toplevel)"

modus=push
basis=""
if [ "${1:-}" = "--probe" ]; then
    modus=probe
    shift || true
    basis=${1:-}
fi

zuruecksetzen() { rm -f "$dateien"; }
dateien=$(mktemp)
trap 'zuruecksetzen' EXIT INT TERM

# Ob `cargo fmt` wirklich läuft, steht hier oben und nicht erst beim Job: auch
# der Trockenlauf soll sagen, ob der `fmt`-Job laufen würde.
#
# Geprüft wird mit einem echten Aufruf, nicht mit `command -v`: rustup legt seine
# Proxy-Binaries in ~/.cargo/bin unabhängig von den installierten Komponenten ab.
# Fehlt die Komponente, findet `command -v` den Proxy trotzdem, und `cargo fmt`
# endet mit einem Fehler — der Job würde dann „rot“ melden, obwohl nichts über
# die Formatierung gesagt ist.
fmt_bereit() {
    command -v cargo > /dev/null || return 1
    cargo fmt --version > /dev/null 2>&1
}

# Dasselbe für den Fuzz-Rauchlauf: cargo-fuzz und nightly gehören nicht zur
# normalen Werkzeugkette (rund ein halber Gigabyte). Fehlt eines, wird der Lauf
# ausgelassen — und benannt, denn ausgelassen heißt nicht grün. Der Grund steht
# in `$fuzz_grund`, damit Trockenlauf und Ernstfall denselben Text zeigen.
fuzz_bereit() {
    if ! command -v cargo-fuzz > /dev/null; then
        fuzz_grund="cargo-fuzz fehlt: cargo install cargo-fuzz --locked"
        return 1
    fi
    if ! rustc +nightly --version > /dev/null 2>&1; then
        fuzz_grund="nightly fehlt: rustup toolchain install nightly"
        return 1
    fi
    return 0
}

if [ "$modus" = "push" ]; then
    # Git schreibt je Ref „<lokale ref> <sha> <remote ref> <sha>“ nach stdin.
    # Diese Zeilen sind die einzige verlässliche Auskunft darüber, was
    # übertragen wird.
    refs=$(cat)

    if [ "${VCI_SKIP_HOOK:-0}" = "1" ]; then
        echo "pre-push: Tests übersprungen (VCI_SKIP_HOOK=1) — geprüft wurde nichts." >&2
        exit 0
    fi

    # Vier Fälle je Ref:
    #   - Ref wird gelöscht (lokale Sha null): nichts zu prüfen
    #   - neuer Branch (remote Sha null): ohne Vergleichsbasis wird alles geprüft
    #   - bekannt: Diff zwischen remote und lokal
    #   - Diff nicht möglich (force push, unbekannte Sha): alles prüfen
    while read -r _lref lsha _rref rsha; do
        [ -n "${lsha:-}" ] || continue
        case "$lsha" in 0000000000*) continue ;; esac
        case "${rsha:-}" in
            0000000000*|"")
                echo '*' >> "$dateien"
                continue
                ;;
        esac
        git diff --name-only "$rsha" "$lsha" >> "$dateien" 2>/dev/null ||
            echo '*' >> "$dateien"
    done <<EOF
$refs
EOF

    # Kein stdin (Aufruf von Hand) heißt: nichts bekannt, also alles prüfen.
    # Ein *leerer* Diff ist dagegen eine gültige Auskunft — „nichts zu
    # übertragen“ (etwa wenn der Remote-Stand schon erreicht ist) — und darf
    # nicht als Unbekanntes gewertet werden.
    if [ -z "$refs" ]; then
        echo '*' >> "$dateien"
    fi
else
    # Trockenlauf: Basis ist der Upstream des aktuellen Branches, sonst der
    # übliche Remote-Branch, sonst gibt es nichts zu vergleichen.
    if [ -z "$basis" ]; then
        basis=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
    fi
    if [ -z "$basis" ]; then
        for kandidat in origin/main origin/master origin/HEAD; do
            if git rev-parse --verify --quiet "$kandidat" > /dev/null 2>&1; then
                basis=$kandidat
                break
            fi
        done
    fi

    if [ -n "$basis" ] && git rev-parse --verify --quiet "$basis" > /dev/null 2>&1; then
        voraus=$(git rev-list --count "$basis"..HEAD 2>/dev/null || echo '?')
        echo "Trockenlauf gegen $basis ($voraus Commit(s) voraus)" >&2
        git diff --name-only "$basis"...HEAD > "$dateien"
    else
        basis=""
        echo '*' >> "$dateien"
        echo "Trockenlauf ohne Vergleichsbasis — es würden alle Prüfungen laufen." >&2
    fi
fi

kern=0
jvm=0
fuzz=0
alle=0
while read -r f; do
    case "$f" in
        '') continue ;;
        '*')
            alle=1
            kern=1
            jvm=1
            fuzz=1
            ;;
        # Doku fährt alle fünf mit. Ein Doku-Push wäre sonst der einzige Fall,
        # in dem der Hook gar nichts über den Push sagt — und der Lauf dauert
        # warm rund 40 s, die Hälfte davon die JVM-Tests. `alle=1` genügt, die
        # Job-Auswahl weiter unten liest es aus.
        docs/* | *.md | artifacts/* | model/*) alle=1 ;;
        core/src/isotp.rs | core/src/uds.rs) kern=1; fuzz=1 ;;
        core/fuzz/*) fuzz=1 ;;
        core/* | core-ffi/* | j2534/*) kern=1 ;;
        android/*) jvm=1 ;;
        scripts/kern-tests.sh | scripts/ci-lokal.sh) kern=1 ;;
        scripts/jvm-tests.sh) jvm=1 ;;
        *)
            alle=1
            kern=1
            jvm=1
            ;;
    esac
done < "$dateien"

anzahl=$(sort -u "$dateien" | wc -l | tr -d ' ')

# Welche Jobs des CI-Laufs dieser Push braucht. `c`, `rust`, `clippy` und `fmt`
# gehören zum Rust- und C-Kern; `jvm-tests` zur App. Bei unbekannter Dateiliste
# laufen alle fünf — genau wie in der CI, wo kein Job vom anderen abhängt.
ci_jobs=""
if [ "$alle" -eq 1 ]; then
    ci_jobs="c rust clippy fmt jvm-tests"
else
    if [ "$kern" -eq 1 ]; then
        ci_jobs="c rust clippy fmt"
    fi
    if [ "$jvm" -eq 1 ]; then
        ci_jobs="$ci_jobs jvm-tests"
    fi
fi

# Der `fmt`-Job hängt an der rustfmt-Komponente. Fehlt sie, wird er ausgelassen
# und benannt — nicht als rot gemeldet, denn über die Formatierung sagt das
# nichts.
fmt_ausgelassen=""
if [ -n "$ci_jobs" ]; then
    if ! fmt_bereit; then
        rest=""
        for job in $ci_jobs; do
            if [ "$job" != "fmt" ]; then
                rest="$rest $job"
            fi
        done
        ci_jobs=${rest# }
        fmt_ausgelassen="cargo fmt fehlt: rustup component add rustfmt"
    fi
fi

if [ "$modus" = "probe" ]; then
    if [ -n "$basis" ]; then
        echo "Geänderte Dateien:" >&2
        sort -u "$dateien" | sed 's/^/  /' >&2
    fi
    # Hierher kommt nur noch ein leerer Diff: Doku läuft inzwischen mit.
    if [ -z "$ci_jobs" ] && [ "$fuzz" -eq 0 ]; then
        echo "Auswahl: nichts — keine Änderungen gegenüber $basis." >&2
        exit 0
    fi
    echo "Auswahl:" >&2
    if [ -n "$ci_jobs" ]; then
        echo "  scripts/ci-lokal.sh    ($ci_jobs)" >&2
    fi
    if [ -n "$fmt_ausgelassen" ]; then
        echo "  fmt                    (würde ausgelassen — $fmt_ausgelassen)" >&2
    fi
    if [ "$fuzz" -eq 1 ]; then
        if fuzz_bereit; then
            echo "  scripts/fuzz.sh        (Rauchlauf ISO-TP und UDS, ${VCI_FUZZ_SEKUNDEN:-20} s je Ziel)" >&2
        else
            echo "  scripts/fuzz.sh        (würde ausgelassen — $fuzz_grund)" >&2
        fi
    fi
    exit 0
fi

# Nur ein leerer Diff landet hier: jede geänderte Datei wählt mindestens einen
# Job, Doku alle fünf.
if [ -z "$ci_jobs" ] && [ "$fuzz" -eq 0 ]; then
    echo "pre-push: nichts zu übertragen ($anzahl Dateien) — keine Tests nötig." >&2
    exit 0
fi

fehlgeschlagen=0
gesamt_start=$(date +%s)

# Alle Läufe werden gefahren, auch wenn der erste rot ist: wer ohnehin nicht
# pushen kann, soll alle Befunde auf einmal sehen. Die Ausgabe kommt gesammelt,
# weil ein Fehlschlag mitten in einer Fortschrittszeile sonst unlesbar ist.
pruefe() { # <Titel> <Skript> [Argumente …]
    titel=$1
    skript=$2
    shift 2
    log=$(mktemp)
    start=$(date +%s)

    echo "pre-push: $titel läuft …" >&2
    if sh "$skript" "$@" > "$log" 2>&1; then
        echo "pre-push: $titel grün ($(( $(date +%s) - start )) s)." >&2
        rm -f "$log"
        return 0
    fi

    fehlgeschlagen=1
    echo "pre-push: $titel rot ($(( $(date +%s) - start )) s):" >&2
    echo "------------------------------------------------------------" >&2
    tail -n 40 "$log" | sed 's/^/    /' >&2
    echo "------------------------------------------------------------" >&2
    rm -f "$log"
    return 0
}

# Bewusst kein `[ … ] && pruefe …`: unter `set -e` beendet die fehlgeschlagene
# Bedingung das Skript, statt die Prüfung zu überspringen.
if [ -n "$fmt_ausgelassen" ]; then
    echo "pre-push: Formatprüfung übersprungen — $fmt_ausgelassen." >&2
fi
if [ -n "$ci_jobs" ]; then
    pruefe "lokaler CI-Lauf ($ci_jobs)" scripts/ci-lokal.sh $ci_jobs
fi

# Kurz, weil er bei jedem Push auf Parser-Code mitläuft: 20 s je Ziel zeigen,
# dass die Ziele noch bauen und nicht sofort abstürzen. Die zehn Minuten aus der
# Definition of Done bleiben Handarbeit (`sh scripts/fuzz.sh`).
if [ "$fuzz" -eq 1 ]; then
    if fuzz_bereit; then
        VCI_FUZZ_SEKUNDEN=${VCI_FUZZ_SEKUNDEN:-20}
        export VCI_FUZZ_SEKUNDEN
        pruefe "Fuzz-Rauchlauf (${VCI_FUZZ_SEKUNDEN} s je Ziel)" scripts/fuzz.sh
    else
        echo "pre-push: Fuzz-Rauchlauf übersprungen — $fuzz_grund." >&2
    fi
fi

if [ "$fehlgeschlagen" -ne 0 ]; then
    echo "pre-push: Prüfung rot — Push abgebrochen, nichts wurde übertragen." >&2
    echo "Ganze Ausgabe: sh scripts/ci-lokal.sh, sh scripts/fuzz.sh" >&2
    exit 1
fi

echo "pre-push: alles grün in $(( $(date +%s) - gesamt_start )) s." >&2
