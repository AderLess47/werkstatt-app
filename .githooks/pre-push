#!/bin/sh
# Pre-Push: die JVM-Tests der App müssen grün sein, bevor etwas hinausgeht.
#
# Warum lokal und nicht nur in der CI: die Actions-Läufe dieses Repos starten
# nicht mehr — jedes Job-Ergebnis ist „The job was not started because recent
# account payments have failed or your spending limit needs to be increased“,
# also kein Runner, kein Schritt, kein Test. Bis das geklärt ist, ist dieser Hook
# die einzige Prüfung, die wirklich läuft. Sie fährt dieselben 119 Tests wie der
# CI-Job `jvm-tests`.
#
# Einbauen:      sh scripts/install-hooks.sh
# Abschalten:    VCI_SKIP_HOOK=1 git push …
# Der Hook sagt beim Überspringen, dass er übersprungen wurde — still wäre es
# dasselbe wie „grün“.

set -eu

cd "$(git rev-parse --show-toplevel)"

# Git schreibt je Ref „<lokale ref> <sha> <remote ref> <sha>“ nach stdin. Wer das
# nicht liest, lässt git in eine geschlossene Pipe schreiben — also lesen.
cat > /dev/null || true

if [ "${VCI_SKIP_HOOK:-0}" = "1" ]; then
    echo "pre-push: JVM-Tests übersprungen (VCI_SKIP_HOOK=1) — geprüft wurde nichts." >&2
    exit 0
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT INT TERM

echo "pre-push: JVM-Tests der App laufen (etwa 20 s) …" >&2
start=$(date +%s)
if sh scripts/jvm-tests.sh > "$log" 2>&1; then
    dauer=$(( $(date +%s) - start ))
    ergebnis=$(grep -E '^OK \(' "$log" | tail -1)
    echo "pre-push: ${ergebnis:-grün} in ${dauer} s." >&2
    exit 0
fi

# Rot heißt: nicht pushen. Die Ausgabe kommt gesammelt, weil ein Fehlschlag
# mitten in einer Fortschrittszeile sonst unlesbar ist.
echo "pre-push: Tests rot — Push abgebrochen, nichts wurde übertragen." >&2
echo "------------------------------------------------------------" >&2
tail -n 60 "$log" >&2
echo "------------------------------------------------------------" >&2
echo "Ganze Ausgabe: sh scripts/jvm-tests.sh" >&2
exit 1
